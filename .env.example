# Kopiraj ovaj fajl u .env i upiši svoje podatke. .env se NE šalje na GitHub.

# live = pravi novac, paper = simulacija
MODE=live

# Bilo koja berza koju ccxt podržava: binance, kraken, bybit, kucoin, okx...
EXCHANGE=binance
API_KEY=
API_SECRET=

SYMBOL=BTC/USDT
TIMEFRAME=15m

# Najviše USDT koje bot sme da koristi (130 KM je otprilike 70-75 USDT)
MAX_CAPITAL=60
# Prodaj ako cena padne 2% ispod kupovne
STOP_LOSS_PCT=2
# Prodaj ako cena poraste 4% iznad kupovne
TAKE_PROFIT_PCT=4
# Posle ovoliko USDT gubitka u jednom danu, bez novih kupovina do sutra
DAILY_LOSS_LIMIT=5

POLL_SECONDS=30
