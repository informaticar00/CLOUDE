# ===== Telegram =====
# Token od @BotFather
TELEGRAM_TOKEN=123456:ABC-DEF...
# Tvoj chat ID (saznaj preko @userinfobot). Više ID-eva odvoji zarezom.
ALLOWED_CHAT_IDS=123456789

# ===== Način rada =====
# paper = simulacija (bez pravog novca) | oanda = OANDA račun | mt5 = MetaTrader 5 račun
MODE=paper
# Izvor cijena: yahoo (besplatno, bez ključa, GC=F futures) | oanda | mt5
# Kad je MODE=oanda ili MODE=mt5, DATA_SOURCE mora biti isto to.
# Možeš i MODE=paper + DATA_SOURCE=mt5: simulacija na cijenama tvog MT5 brokera.
DATA_SOURCE=yahoo

# ===== OANDA (samo ako MODE=oanda ili DATA_SOURCE=oanda) =====
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# practice = demo račun | live = pravi novac
OANDA_ENV=practice

# ===== MetaTrader 5 (samo ako MODE=mt5 ili DATA_SOURCE=mt5, samo Windows) =====
# Ako je MT5 terminal već otvoren i prijavljen, login/lozinku/server možeš ostaviti prazno.
MT5_LOGIN=
MT5_PASSWORD=
# Tačan naziv servera kao u MT5 prozoru za prijavu, npr. ICMarketsSC-Demo
MT5_SERVER=
# Putanja do terminal64.exe (samo ako imaš više MT5 terminala instaliranih)
MT5_PATH=
# Naziv simbola za zlato kod tvog brokera: XAUUSD, XAUUSD.m, XAUUSD+, GOLD...
MT5_SYMBOL=XAUUSD
# Broj kojim bot označava svoje pozicije (ručne pozicije ne dira)
MT5_MAGIC=20260
# Dozvoljeno klizanje cijene u pointima
MT5_DEVIATION=50

# ===== PRAVI NOVAC =====
# Dok je ovo false, bot NEĆE otvarati pozicije na REAL (MT5) ili live (OANDA) računu.
# Demo računi rade bez obzira na ovo.
ALLOW_REAL_MONEY=false

# ===== Strategija =====
# M1, M5, M15, M30, H1, D
TIMEFRAME=M15
EMA_FAST=9
EMA_SLOW=21
# EMA trend filter (0 = isključen)
EMA_TREND=200
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
# Stop loss = ATR * ATR_SL_MULT
ATR_SL_MULT=1.5
# Take profit = SL udaljenost * RISK_REWARD
RISK_REWARD=2.0

# ===== Upravljanje rizikom =====
# % salda koji se rizikuje po trejdu
RISK_PCT=1.0
# Maksimalna veličina pozicije (unce; kod MT5 obično 1 lot = 100 unci)
MAX_UNITS=50
MAX_OPEN_POSITIONS=1
# Ako dnevni gubitak pređe ovaj %, auto-trading se gasi do sutra
DAILY_LOSS_LIMIT_PCT=3.0

# ===== Ostalo =====
# Koliko često (sekunde) bot provjerava tržište
CHECK_INTERVAL=60
# Da li je auto-trading uključen odmah po pokretanju
AUTO_TRADE_ON_START=false
PAPER_START_BALANCE=10000
# Simulirani spread u USD (samo paper)
PAPER_SPREAD=0.30
PAPER_STATE_FILE=paper_state.json
# Postavke promijenjene iz Telegrama čuvaju se ovdje (imaju prednost nad .env)
SETTINGS_FILE=postavke.json
