# Kopirajte u .env i popunite. Fajl .env nikad ne commitajte.
PORT=3000

# WhatsApp Cloud API (Meta for Developers -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=bs

# Odobreni šablon koji dobija klijent; {{1}} = ime klijenta
WHATSAPP_TEMPLATE_CLIENT=upit_zaprimljen

# Službeni WhatsApp broj firme (npr. 061 123 456 ili +38761123456).
# Koristi se za dugme "Pišite nam na WhatsApp" i za obavijest o novom upitu.
COMPANY_WHATSAPP=
# Opcionalni šablon za obavijest firmi; {{1}} ime, {{2}} telefon, {{3}} email, {{4}} usluga, {{5}} upit
WHATSAPP_TEMPLATE_COMPANY=novi_upit
