# Kopirajte u .env i popunite. Fajl .env nikad ne commitajte.
PORT=3000

# WhatsApp Cloud API (Meta for Developers -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=bs

# Odobreni šablon koji dobija klijent; {{1}} = ime klijenta
WHATSAPP_TEMPLATE_CLIENT=upit_zaprimljen

# Službeni WhatsApp broj firme. Koristi se za dugme "Pišite nam na WhatsApp"
# i za obavijest o novom upitu. Ako se izostavi, koristi se 067 104 2939.
COMPANY_WHATSAPP=067 104 2939
# Opcionalni šablon za obavijest firmi; {{1}} ime, {{2}} telefon, {{3}} email, {{4}} usluga, {{5}} upit
WHATSAPP_TEMPLATE_COMPANY=novi_upit

# Email (SMTP). Za Gmail: SMTP_USER = Gmail adresa, SMTP_PASS = "lozinka za aplikacije"
# (Google račun -> Sigurnost -> Potvrda u 2 koraka -> Lozinke za aplikacije), ne obična lozinka.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Adresa na koju stižu obavijesti o novim upitima (podrazumijevano SMTP_USER)
COMPANY_EMAIL=
# Pošiljalac koji klijent vidi (podrazumijevano "Glock Sigurnost" <SMTP_USER>)
MAIL_FROM=
