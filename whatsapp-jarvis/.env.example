# Kopiraj u .env (ili upiši u postavke hostinga) i popuni.

# Anthropic API ključ: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Meta / WhatsApp Cloud API (developers.facebook.com -> tvoja aplikacija -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Proizvoljna tajna riječ koju upišeš i ovdje i u Meta postavkama webhooka
WHATSAPP_VERIFY_TOKEN=izmisli-nesto-dugo
# App Secret (App settings -> Basic). Provjerava da poruke stvarno dolaze od Mete.
WHATSAPP_APP_SECRET=

# Tvoj osobni broj, međunarodni format bez + (npr. 38761123456). Više brojeva odvoji zarezom.
ALLOWED_NUMBERS=

# Personalizacija (neobavezno)
ASSISTANT_NAME=Jarvis
USER_NAME=
ABOUT_ME=
TZ=Europe/Sarajevo
